function MatchesPage({ profile, saved, onToggleSave, onNav }) {
  const savedIds = useMemo(() => new Set(saved.map((s) => s.id)), [saved]);
  const grouped = useMemo(() => {
    if (!profile) return null;
    const groups = { eligible: [], potential: [], "not-eligible": [] };
    PLACEX_DATA.companies.forEach((c) => {
      const m = computeMatch(profile, c);
      if (groups[m.status]) groups[m.status].push(c);
    });
    return groups;
  }, [profile]);

  if (PLACEX_DATA.companies.length === 0) {
    return (
      <div className="page">
        <PageHead title="My matches" sub="Complete onboarding to see personalized matches." />
        <NoDataEmpty icon={<Target size={30} />} body="Matches are calculated live from your profile against real eligibility rules — there's just no dataset loaded to match against yet." />
      </div>
    );
  }
  if (!profile) {
    return (
      <div className="page">
        <PageHead title="My matches" />
        <NoDataEmpty icon={<Target size={30} />} title="Set up your profile first" body="PlaceX needs your branch and CGPA to calculate real matches." action={<button className="btn btn-primary btn-sm" onClick={() => onNav("settings")}>Go to Settings</button>} />
      </div>
    );
  }

  return (
    <div className="page">
      <PageHead title="My matches" sub={`Calculated from ${profile.branch} · CGPA ${profile.cgpa} against ${PLACEX_DATA.companies.length} roles.`} />
      {MATCH_ORDER.map((status) => (
        <div key={status}>
          <div className="match-group-head"><span className={`match-badge match-${status}`}>{MATCH_GROUP_TITLES[status]}</span> {grouped[status].length}</div>
          {grouped[status].length === 0
            ? <div style={{ fontSize: 13, color: "var(--text-faint)", marginBottom: 10 }}>None in this category.</div>
            : (
              <div className="company-grid">
                {grouped[status].map((c) => (
                  <CompanyCard key={c.id} company={c} profile={profile} isSaved={savedIds.has(c.id)} onToggleSave={onToggleSave} onNav={onNav} />
                ))}
              </div>
            )}
        </div>
      ))}
    </div>
  );
}

