  const sameError = a && b && a === b;
  const compA = companies.find((c) => c.id === a);
  const compB = companies.find((c) => c.id === b);

  const rows = compA && compB && !sameError ? [
    { label: "Package", a: typeof compA.compensation?.max_ctc_lpa === "number" ? `${compA.compensation.max_ctc_lpa} LPA` : "Not available", b: typeof compB.compensation?.max_ctc_lpa === "number" ? `${compB.compensation.max_ctc_lpa} LPA` : "Not available", winner: (compA.compensation?.max_ctc_lpa || 0) === (compB.compensation?.max_ctc_lpa || 0) ? null : (compA.compensation?.max_ctc_lpa || 0) > (compB.compensation?.max_ctc_lpa || 0) ? "a" : "b" },
    { label: "CGPA cutoff", a: compA.cgpa?.status === "known" ? compA.cgpa.min : compA.cgpa?.status === "no_cutoff" ? "None" : "Unspecified", b: compB.cgpa?.status === "known" ? compB.cgpa.min : compB.cgpa?.status === "no_cutoff" ? "None" : "Unspecified" },
    { label: "Eligibility", a: compA.eligibleAllBranches ? "All branches" : `${(compA.eligibleBranches || []).length} branches`, b: compB.eligibleAllBranches ? "All branches" : `${(compB.eligibleBranches || []).length} branches`, winner: (compA.eligibleAllBranches ? 999 : (compA.eligibleBranches || []).length) === (compB.eligibleAllBranches ? 999 : (compB.eligibleBranches || []).length) ? null : (compA.eligibleAllBranches ? 999 : (compA.eligibleBranches || []).length) > (compB.eligibleAllBranches ? 999 : (compB.eligibleBranches || []).length) ? "a" : "b" },
    { label: "Location", a: compA.location || "Not available", b: compB.location || "Not available" },
    { label: "Placement year", a: compA.year, b: compB.year },
    { label: "Offers", a: compA.offers ?? "Not available", b: compB.offers ?? "Not available" },
    { label: "Interview rounds", a: compA.interviewRounds || "Not available", b: compB.interviewRounds || "Not available" },
  ] : [];

  return (
    <div className="page">
      <PageHead title="Compare" sub="Put any two companies or roles side by side." />
      {companies.length === 0
        ? <NoDataEmpty icon={<GitCompare size={30} />} body="Comparison needs at least two companies in the dataset. Nothing to compare until real placement data is imported." />
        : (
          <>
            <div className="compare-grid">
              <select className="compare-select" value={a} onChange={(e) => setA(e.target.value)}>
                <option value="">Select company A</option>
                {companies.map((c) => <option key={c.id} value={c.id}>{c.company} — {c.profile}</option>)}
              </select>
              <select className="compare-select" value={b} onChange={(e) => setB(e.target.value)}>
                <option value="">Select company B</option>
                {companies.map((c) => <option key={c.id} value={c.id}>{c.company} — {c.profile}</option>)}
              </select>
            </div>
            {sameError && <div style={{ marginTop: 14, color: "var(--crimson)", fontSize: 13.5, display: "flex", gap: 6, alignItems: "center" }}><AlertCircle size={14} /> Pick two different companies to compare.</div>}
            {rows.length > 0 && (
              <div className="card" style={{ marginTop: 22, padding: 0, overflow: "hidden" }}>
                <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 13.5 }}>
                  <thead>
                    <tr style={{ borderBottom: "1px solid var(--border)" }}>
                      <th style={{ textAlign: "left", padding: "12px 16px", color: "var(--text-faint)", fontFamily: "var(--font-mono)", fontSize: 11, textTransform: "uppercase" }}></th>
                      <th style={{ textAlign: "left", padding: "12px 16px", fontFamily: "var(--font-display)" }}>{compA.company}</th>
                      <th style={{ textAlign: "left", padding: "12px 16px", fontFamily: "var(--font-display)" }}>{compB.company}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {rows.map((r) => (
                      <tr key={r.label} style={{ borderBottom: "1px solid var(--border)" }}>
                        <td style={{ padding: "12px 16px", color: "var(--text-faint)" }}>{r.label}</td>
                        <td style={{ padding: "12px 16px", color: r.winner === "a" ? "var(--good)" : "var(--text)", fontWeight: r.winner === "a" ? 600 : 400 }}>{String(r.a)}</td>
                        <td style={{ padding: "12px 16px", color: r.winner === "b" ? "var(--good)" : "var(--text)", fontWeight: r.winner === "b" ? 600 : 400 }}>{String(r.b)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </>
        )}
    </div>
  );
}

function AnalyticsPage({ onNav }) {
  const [year, setYear] = useState("");
  const companies = useMemo(() => PLACEX_DATA.companies.filter((c) => !year || c.year === year), [year]);

  const stats = useMemo(() => {
    const packages = companies.map((c) => c.compensation?.max_ctc_lpa).filter((v) => typeof v === "number").sort((a, b) => a - b);
    const highest = packages.length ? packages[packages.length - 1] : null;
    const average = packages.length ? (packages.reduce((a, b) => a + b, 0) / packages.length) : null;
    const median = packages.length ? packages[Math.floor(packages.length / 2)] : null;
    return { total: companies.length, highest, average, median, withPackage: packages.length };
  }, [companies]);

  const packageChart = useMemo(() => {
    const buckets = {};
    companies.forEach((c) => {
      const lpa = c.compensation?.max_ctc_lpa;
      if (typeof lpa !== "number") return;
      const bucket = `${Math.floor(lpa / 10) * 10}-${Math.floor(lpa / 10) * 10 + 10}`;
      buckets[bucket] = (buckets[bucket] || 0) + 1;
    });
    return Object.entries(buckets).sort((a, b) => parseInt(a[0]) - parseInt(b[0])).map(([range, count]) => ({ range, count }));
  }, [companies]);

  const roleChart = useMemo(() => {
    const counts = {};
    companies.forEach((c) => (c.roleCategories || []).forEach((r) => { counts[r] = (counts[r] || 0) + 1; }));
    return Object.entries(counts).sort((a, b) => b[1] - a[1]).map(([role, count]) => ({ role, count }));
  }, [companies]);

  const topCompanies = useMemo(() => {
    return [...companies].filter((c) => typeof c.compensation?.max_ctc_lpa === "number")
      .sort((a, b) => b.compensation.max_ctc_lpa - a.compensation.max_ctc_lpa).slice(0, 8);
  }, [companies]);

  if (PLACEX_DATA.companies.length === 0) {
    return (
      <div className="page">
        <PageHead title="Analytics" sub="Calculated live from the current dataset — no static charts." />
        <NoDataEmpty icon={<BarChart3 size={30} />} body="Summary stats, package distribution, and top companies will populate here as soon as real placement data is loaded." />
      </div>
    );
  }

  return (
    <div className="page">
      <PageHead title="Analytics" sub="Calculated live from the current dataset — no static charts." />
      <div className="filter-bar">
        <select value={year} onChange={(e) => setYear(e.target.value)}>
          <option value="">All years</option>
          {SUPPORTED_YEARS.filter((y) => PLACEX_DATA.companies.some((c) => c.year === y)).map((y) => <option key={y} value={y}>{y}</option>)}
        </select>
      </div>

      <div className="metric-grid">
        <div className="metric-card"><div className="label">Total roles</div><div className="value">{stats.total}</div></div>
        <div className="metric-card"><div className="label">Highest package</div><div className="value">{stats.highest ? `${stats.highest} LPA` : "—"}</div></div>
        <div className="metric-card"><div className="label">Average package</div><div className="value">{stats.average ? `${stats.average.toFixed(1)} LPA` : "—"}</div></div>
        <div className="metric-card"><div className="label">Median package</div><div className="value">{stats.median ? `${stats.median} LPA` : "—"}</div></div>
      </div>

      {stats.total === 0 ? <NoDataEmpty title="No data for this filter" body="Try a different year." /> : (
        <>
          <div className="card" style={{ height: 300, marginBottom: 20 }}>
            <div style={{ fontFamily: "var(--font-display)", fontWeight: 600, marginBottom: 12, fontSize: 14 }}>Package distribution (LPA)</div>
            <ResponsiveContainer width="100%" height="88%">
              <BarChart data={packageChart}>
                <CartesianGrid strokeDasharray="3 3" stroke="var(--border)" />
                <XAxis dataKey="range" stroke="var(--text-faint)" fontSize={12} />
                <YAxis stroke="var(--text-faint)" fontSize={12} allowDecimals={false} />
                <Tooltip contentStyle={{ background: "var(--surface)", border: "1px solid var(--border)" }} />
                <Bar dataKey="count" fill="var(--crimson)" radius={[6, 6, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </div>

          <div className="card" style={{ height: 260, marginBottom: 20 }}>
            <div style={{ fontFamily: "var(--font-display)", fontWeight: 600, marginBottom: 12, fontSize: 14 }}>Role distribution</div>
            <ResponsiveContainer width="100%" height="80%">
              <BarChart data={roleChart} layout="vertical" margin={{ left: 20 }}>
                <CartesianGrid strokeDasharray="3 3" stroke="var(--border)" />
                <XAxis type="number" stroke="var(--text-faint)" fontSize={12} allowDecimals={false} />
                <YAxis type="category" dataKey="role" stroke="var(--text-faint)" fontSize={12} width={90} />
                <Tooltip contentStyle={{ background: "var(--surface)", border: "1px solid var(--border)" }} />
                <Bar dataKey="count" fill="var(--crimson)" radius={[0, 6, 6, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </div>

          <div className="card">
            <div style={{ fontFamily: "var(--font-display)", fontWeight: 600, marginBottom: 12, fontSize: 14 }}>Top packages</div>
            <div style={{ display: "grid", gap: 8 }}>
              {topCompanies.map((c) => (
                <div key={c.id} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "8px 4px", cursor: "pointer" }} onClick={() => onNav("company", c.id)}>
                  <div><div style={{ fontSize: 13.5 }}>{c.company}</div><div style={{ fontSize: 12, color: "var(--text-faint)" }}>{c.profile}</div></div>
                  <div style={{ fontFamily: "var(--font-mono)", fontSize: 13, color: "var(--crimson)" }}>{c.compensation.max_ctc_lpa} LPA</div>
                </div>
              ))}
            </div>
          </div>
        </>
      )}
    </div>
  );
}

function SettingsPage({ profile, theme, onToggleTheme, onUpdateProfile, onClearSaved, onClearDSA }) {
  const [form, setForm] = useState(profile || {});
  const [saved, setSaved] = useState(false);
  useEffect(() => { setForm(profile || {}); }, [profile]);

  const save = () => {
    onUpdateProfile({ ...form, cgpa: parseFloat(form.cgpa) });
    setSaved(true);
    setTimeout(() => setSaved(false), 1800);
  };

  return (
    <div className="page">
      <PageHead title="Settings" />
      <div className="settings-section">
        <h2>Profile</h2>
        <div className="field"><label>Name</label><input value={form.name || ""} onChange={(e) => setForm({ ...form, name: e.target.value })} /></div>
        <div className="field"><label>Branch</label>
          <select value={form.branch || ""} onChange={(e) => setForm({ ...form, branch: e.target.value })}>
            {CANONICAL_BRANCHES.map((b) => <option key={b} value={b}>{b}</option>)}
          </select>
        </div>
        <div className="field"><label>CGPA</label><input type="number" step="0.01" value={form.cgpa ?? ""} onChange={(e) => setForm({ ...form, cgpa: e.target.value })} /></div>
        <button className="btn btn-primary btn-sm" onClick={save}>{saved ? <><Check size={14} /> Saved</> : "Save profile"}</button>
      </div>

      <div className="settings-section">
        <h2>Appearance</h2>
        <div className="theme-row">
          <button className={`theme-opt ${theme === "light" ? "active" : ""}`} onClick={() => theme !== "light" && onToggleTheme()}>Light</button>
          <button className={`theme-opt ${theme === "dark" ? "active" : ""}`} onClick={() => theme !== "dark" && onToggleTheme()}>Dark</button>
        </div>
      </div>

      <div className="settings-section">
        <h2>Data</h2>
        <div style={{ display: "flex", gap: 10, flexWrap: "wrap" }}>
          <button className="btn btn-ghost btn-sm" onClick={onClearSaved}>Clear saved companies</button>
          <button className="btn btn-ghost btn-sm" onClick={onClearDSA}>Reset DSA progress</button>
        </div>
      </div>

      <div className="settings-section">
        <h2>About</h2>
        <p style={{ fontSize: 13.5, color: "var(--text-dim)", lineHeight: 1.6 }}>
          PlaceX · IITM Intelligence. Data source: IIT Madras Placement Bluebooks (not yet imported into this build). Every number in this app is calculated from real state — nothing here is fabricated.
        </p>
      </div>
    </div>
  );
}

/* ============================================================
   ROOT APP
   ============================================================ */
export default function App() {
  const [ready, setReady] = useState(false);
  const [theme, setTheme] = useState("dark");
  const [profile, setProfile] = useState(null);
  const [saved, setSaved] = useState([]);
  const [dsaProgress, setDsaProgress] = useState({ solved: 0, total: 0, dailyGoal: 2 });
  const [route, setRoute] = useState({ route: "", param: null });
  const [searchOpen, setSearchOpen] = useState(false);
  const [aiOpen, setAiOpen] = useState(false);

  // Initial load
  useEffect(() => {
    (async () => {
      const [t, p, s, d] = await Promise.all([
        loadKey("placex:theme", "dark"),
        loadKey("placex:profile", null),
        loadKey("placex:saved", []),
        loadKey("placex:dsa-progress", { solved: 0, total: 0, dailyGoal: 2 }),
      ]);
      setTheme(t);
      setProfile(p);
      setSaved(s);
      setDsaProgress(d);
      const initial = parseHash();
      if (!initial.route) {
        window.location.hash = p ? "/home" : "/";
        setRoute({ route: p ? "home" : "", param: null });
      } else {
        setRoute(initial);
      }
      setReady(true);
    })();
  }, []);

  // Hash routing
  useEffect(() => {
    const onHash = () => setRoute(parseHash());
    window.addEventListener("hashchange", onHash);
    return () => window.removeEventListener("hashchange", onHash);
  }, []);

  // Keyboard shortcut for search
  useEffect(() => {
    const onKey = (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); setSearchOpen(true); }
      if (e.key === "Escape") setSearchOpen(false);
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, []);

  const goto = useCallback((r, param) => navigate(r, param), []);

  const toggleTheme = () => {
    const next = theme === "dark" ? "light" : "dark";
    setTheme(next);
    saveKey("placex:theme", next);
  };

  const completeOnboarding = (p) => {
    setProfile(p);
    saveKey("placex:profile", p);
    navigate("home");
  };
  const updateProfile = (p) => {
    setProfile(p);
    saveKey("placex:profile", p);
  };
  const getStarted = () => navigate(profile ? "home" : "onboarding");

  const removeSaved = (id) => {
    const next = saved.filter((s) => s.id !== id);
    setSaved(next);
    saveKey("placex:saved", next);
  };
  const toggleSaved = (company) => {
    const exists = saved.some((s) => s.id === company.id);
    const next = exists ? saved.filter((s) => s.id !== company.id) : [...saved, company];
    setSaved(next);
    saveKey("placex:saved", next);
  };
  const clearSaved = () => { setSaved([]); saveKey("placex:saved", []); };
  const clearDSA = () => { const reset = { solved: 0, total: 0, dailyGoal: 2 }; setDsaProgress(reset); saveKey("placex:dsa-progress", reset); };

  if (!ready) {
    return (
      <div className="px-root" data-theme={theme} style={{ display: "grid", placeItems: "center", minHeight: "100vh" }}>
        <style>{CSS}</style>
        <Loader2 size={22} style={{ animation: "spin 1s linear infinite" }} />
        <style>{`@keyframes spin { to { transform: rotate(360deg); } }`}</style>
      </div>
    );
  }

  const isShellPage = route.route && route.route !== "" && route.route !== "onboarding";

  return (
    <div className="px-root" data-theme={theme}>
      <style>{CSS}</style>
      <style>{`@keyframes spin { to { transform: rotate(360deg); } }`}</style>
      <CursorGlow />

      {route.route === "" && <LandingPage theme={theme} onToggleTheme={toggleTheme} onGetStarted={getStarted} />}

      {route.route === "onboarding" && (
        <Onboarding initialProfile={profile} onComplete={completeOnboarding} />
      )}

      {isShellPage && (
        <div className="shell">
          <Sidebar page={route.route} onNav={goto} />
          <div className="main-col">
            <div className="topbar">
              <button className="icon-btn" style={{ display: "none" }} />
              <button className="topbar-search" onClick={() => setSearchOpen(true)}>
                <SearchIcon size={15} /> Search companies, roles, DSA topics… <span style={{ marginLeft: "auto", fontFamily: "var(--font-mono)", fontSize: 11 }}>⌘K</span>
              </button>
              <div style={{ display: "flex", gap: 10, marginLeft: "auto" }}>
                <button className="icon-btn" onClick={() => setAiOpen(true)} aria-label="Ask PlaceX AI"><Sparkles size={16} /></button>
                <ThemeToggle theme={theme} onToggle={toggleTheme} />
                <button className="icon-btn" onClick={() => goto("settings")} aria-label="Profile"><User size={16} /></button>
              </div>
            </div>

            {route.route === "home" && <HomePage profile={profile} saved={saved} dsaProgress={dsaProgress} onNav={goto} />}
            {route.route === "explore" && <ExplorePage profile={profile} saved={saved} onToggleSave={toggleSaved} onNav={goto} />}
            {route.route === "company" && <CompanyPage id={route.param} profile={profile} saved={saved} onToggleSave={toggleSaved} onNav={goto} />}
            {route.route === "saved" && <SavedPage saved={saved} profile={profile} onRemove={removeSaved} onNav={goto} />}
            {route.route === "matches" && <MatchesPage profile={profile} saved={saved} onToggleSave={toggleSaved} onNav={goto} />}
            {route.route === "placement-days" && <PlacementDaysPage onNav={goto} />}
            {route.route === "preparation" && <PreparationPage dsaProgress={dsaProgress} onNav={goto} />}
            {route.route === "roadmap" && <RoadmapPage domainId={route.param} onNav={goto} />}
            {route.route === "dsa" && <DSAPage dsaProgress={dsaProgress} onNav={goto} />}
            {route.route === "dsa-problem" && <DSAProblemPage onNav={goto} />}
            {route.route === "compare" && <ComparePage />}
            {route.route === "analytics" && <AnalyticsPage onNav={goto} />}
            {route.route === "settings" && (
              <SettingsPage
                profile={profile}
                theme={theme}
                onToggleTheme={toggleTheme}
                onUpdateProfile={updateProfile}
                onClearSaved={clearSaved}
                onClearDSA={clearDSA}
              />
            )}
          </div>
          <BottomNav page={route.route} onNav={goto} />
        </div>
      )}

      {searchOpen && <SearchModal onClose={() => setSearchOpen(false)} onNav={goto} />}
      {!aiOpen && isShellPage && (
        <button className="ai-fab" onClick={() => setAiOpen(true)} aria-label="Ask PlaceX AI"><Sparkles size={20} /></button>
      )}
      {aiOpen && <AIPanel profile={profile} onClose={() => setAiOpen(false)} />}
    </div>
  );
}
