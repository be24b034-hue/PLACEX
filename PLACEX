function ExplorePage({ profile, saved, onToggleSave, onNav }) {
  const [filters, setFilters] = useState({ year: "", role: "", branch: "" });
  const [sortBy, setSortBy] = useState("name");
  const savedIds = useMemo(() => new Set(saved.map((s) => s.id)), [saved]);

  const filtered = useMemo(() => {
    let list = PLACEX_DATA.companies.filter((c) => {
      if (filters.year && c.year !== filters.year) return false;
      if (filters.role && !(c.roleCategories || []).includes(filters.role)) return false;
      if (filters.branch && !(c.eligibleAllBranches || (c.eligibleBranches || []).includes(filters.branch))) return false;
      return true;
    });
    const lpa = (c) => (typeof c.compensation?.max_ctc_lpa === "number" ? c.compensation.max_ctc_lpa : -1);
    if (sortBy === "highest") list = [...list].sort((a, b) => lpa(b) - lpa(a));
    else if (sortBy === "lowest") list = [...list].sort((a, b) => lpa(a) - lpa(b));
    else list = [...list].sort((a, b) => a.company.localeCompare(b.company));
    return list;
  }, [filters, sortBy]);

  if (PLACEX_DATA.companies.length === 0) {
    return (
      <div className="page">
        <PageHead title="Explore companies" sub="Every role, filtered by what you're eligible for." />
        <NoDataEmpty body="No companies to explore yet — once placement data is imported, cards for every role appear here with save, compare, and prepare actions." />
      </div>
    );
  }

  return (
    <div className="page">
      <PageHead title="Explore companies" sub={`${PLACEX_DATA.companies.length} roles from the IIT Madras Bluebooks.`} />
      <div className="filter-bar">
        <select value={filters.year} onChange={(e) => setFilters({ ...filters, year: e.target.value })}>
          <option value="">All years</option>
          {SUPPORTED_YEARS.filter((y) => PLACEX_DATA.companies.some((c) => c.year === y)).map((y) => <option key={y} value={y}>{y}</option>)}
        </select>
        <select value={filters.role} onChange={(e) => setFilters({ ...filters, role: e.target.value })}>
          <option value="">All roles</option>
          {ROLE_CATEGORIES.map((r) => <option key={r} value={r}>{r}</option>)}
        </select>
        <select value={filters.branch} onChange={(e) => setFilters({ ...filters, branch: e.target.value })}>
          <option value="">All branches</option>
          {CANONICAL_BRANCHES.map((b) => <option key={b} value={b}>{b}</option>)}
        </select>
        <select value={sortBy} onChange={(e) => setSortBy(e.target.value)}>
          <option value="name">Sort: Company name</option>
          <option value="highest">Sort: Highest package</option>
          <option value="lowest">Sort: Lowest package</option>
        </select>
      </div>
      <div className="result-count">{filtered.length} of {PLACEX_DATA.companies.length} roles</div>
      {filtered.length === 0
        ? <NoDataEmpty title="No results for these filters" body="Try widening your branch, role, or year filter." />
        : (
          <div className="company-grid">
            {filtered.map((c, i) => (
              <div key={c.id} style={{ animationDelay: `${Math.min(i, 12) * 0.04}s` }}>
                <CompanyCard company={c} profile={profile} isSaved={savedIds.has(c.id)} onToggleSave={onToggleSave} onNav={onNav} />
              </div>
            ))}
          </div>
        )}
    </div>
  );
}

